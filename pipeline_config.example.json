{
  "run": {
    // Paths to the where the raw recording(s) are stored
    "phys_paths": [
      "/scratch/user/davcollins/physiology/5800941/session6a"
    ],
    // Wherever you want to save the pipeline output
    "output_dir": "/scratch/user/davcollins/physiology/5800941/kilosort_session6a",
    // Temporary directory to use for processing
    "tmp_dir": "/scratch/user/davcollins/physiology/5800941/tmp",
    // If running on HPC, bind paths to pass to the apptainer image
    "bind_paths": [],
    // Skip any step in the process with these
    "skip_statescoring": false,
    "skip_preprocessing": false,
    "skip_sorting": false,
    "skip_postprocessing": false
  },
  // SpikeInterface kwargs. Make sure n_jobs is lower than your number of logical cores
  "job_kwargs": {
    "n_jobs": 23,
    "chunk_duration": "1s"
  },
  // If you have recordings in multiple formats (e.g. int16, int32) and want to specify which to use.
  // If reuse_source=true and no changes are made during pre-processing, will pass raw binary to kilosort
  // than re-writing it
  "binary": {
    "dtype": null,
    "reuse_source": true
  },
  // Parameters for how strict to be with electrode location alignment and fs differences across recordings
  "concatenation": {
    "align_tolerance_um": 1.0,
    "sampling_frequency_max_diff": 0.0
  },
  // SpikeInterface operations to apply during preprocessing. Order matters
  "preprocessing": {
    "phase_shift": {},
    "center": {"mode": "mean"},
    "common_reference": {
      "reference": "global",
      "operator": "median"
    }
  },
  // Variables for python adaptation of Buzcode state scorer
  "state_scoring": {
    "enabled": true,
    // Rates to resample to for state scoring
    "lfp_rate": 1250.0,
    "emg_rate": 2500.0,
    // If you want to pick specific channels for evaluating slow wave, theta power
    "sw_channels": null,
    "theta_channels": null,
    "min_state_duration_s": 6.0,
    "movement": {
      // If enabled, will use optitrack output to calculate linear velocity and veto
      // sleep bouts that contain movement
      "enabled": true,
      "optitrack_csv": "/scratch/user/davcollins/behavior/5800941/{session}/{session}_optitrack.csv",
      "frame_times": null,
      "adc_stream_name": null,
      "adc_channel": null,
      "save_sanity_plot": true,
      "rigid_body": null,
      "veto": ["NREM", "REM"],
      "threshold": null
    }
  },
  // Use to exclude channels that are known to be faulty. Can pass names (e.g. "CH01") or indices
  "bad_channels": [],
  // Or if you want to detect bad channels automatically
  "detect_bad_channels": {
    "enabled": false,
    "method": "coherence+psd",
    "seed": 0
  },
  // Params to pass to kilosort4. If you applied a CAR during preprocessing, use do_CAR=false here
  "sorting": {
    "nblocks": 5,
    "do_CAR": false
  }
}
